#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE  0
#define QWTY  1
#define FUN   2
#define NUM   3
#define SYM   4
#define MOV   5
#define SCRL  6
#define NAV   7
#define MED   8
#define MOS   9

&lt {
    flavor = "hold-preferred";
    retro-tap;
}; 

/ {

    combos {
        compatible = "zmk,combos";
        combo_lmeta_1 {
            timeout-ms = <50>;
            key-positions = <13 25>;
            bindings = <&kp LGUI>;
        };
        combo_lalt {
            timeout-ms = <50>;
            key-positions = <14 26>;
            bindings = <&kp LALT>;
        };
        combo_lctrl {
            timeout-ms = <50>;
            key-positions = <15 27>;
            bindings = <&kp LCTRL>;
        };
        combo_lshft {
            timeout-ms = <50>;
            key-positions = <16 28>;
            bindings = <&kp LSHFT>;
        };
        combo_lmeta_2 {
            timeout-ms = <50>;
            key-positions = <17 29>;
            bindings = <&kp LGUI>;
        };
        combo_rmeta_1 {
            timeout-ms = <50>;
            key-positions = <18 30>;
            bindings = <&kp RGUI>;
        };
        combo_ralt {
            timeout-ms = <50>;
            key-positions = <19 31>;
            bindings = <&kp RALT>;
        };
        combo_rctrl {
            timeout-ms = <50>;
            key-positions = <20 32>;
            bindings = <&kp RCTRL>;
        };
        combo_rshft {
            timeout-ms = <50>;
            key-positions = <21 33>;
            bindings = <&kp RSHFT>;
        };
        combo_rmeta_2 {
            timeout-ms = <50>;
            key-positions = <22 34>;
            bindings = <&kp RGUI>;
        };
    };

    behaviors {
        // Mod-Morph Definitions for "x/y" (Normal/Shifted)
        mm_amp_pipe: mm_amp_pipe {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp AMPS>, <&kp PIPE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_sqt_grave: mm_sqt_grave {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SQT>, <&kp GRAVE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_dqt_at: mm_dqt_at {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DQT>, <&kp AT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_sqt_lpar: mm_sqt_lpar {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SQT>, <&kp LPAR>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_dqt_rpar: mm_dqt_rpar {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DQT>, <&kp RPAR>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_qmark_excl: mm_qmark_excl {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp QMARK>, <&kp EXCL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_underscore_tilde: mm_underscore_tilde {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp UNDER>, <&kp TILDE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // Numerical Morphs
        mm_n7_fslh:  mm_n7_fslh  { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp N7>, <&kp FSLH>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        mm_n8_star:  mm_n8_star  { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp N8>, <&kp STAR>;  mods = <(MOD_LSFT|MOD_RSFT)>; };
        mm_n9_minus: mm_n9_minus { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp N9>, <&kp MINUS>;  mods = <(MOD_LSFT|MOD_RSFT)>; };
        mm_n4_bslh:  mm_n4_bslh  { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp N4>, <&kp BSLH>;  mods = <(MOD_LSFT|MOD_RSFT)>; };
        mm_n5_caret: mm_n5_caret { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp N5>, <&kp CARET>;  mods = <(MOD_LSFT|MOD_RSFT)>; };
        mm_n6_plus:  mm_n6_plus  { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp N6>, <&kp PLUS>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        mm_n1_hash:  mm_n1_hash  { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp N1>, <&kp HASH>;  mods = <(MOD_LSFT|MOD_RSFT)>; };
        mm_n2_dllr:  mm_n2_dllr  { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp N2>, <&kp DLLR>;  mods = <(MOD_LSFT|MOD_RSFT)>; };
        mm_n3_equal: mm_n3_equal { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp N3>, <&kp EQUAL>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        mm_n0_prcnt: mm_n0_prcnt { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp N0>, <&kp PERCENT>; mods = <(MOD_LSFT|MOD_RSFT)>; };

        // Punctuation Morphs
        mm_com_sc:    mm_com_sc    { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp COMMA>, <&kp SEMI>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        mm_dot_co:    mm_dot_co    { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp DOT>, <&kp COLON>;   mods = <(MOD_LSFT|MOD_RSFT)>; };
        mm_lpar_lt:   mm_lpar_lt   { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp LPAR>, <&kp LT>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        mm_rpar_gt:   mm_rpar_gt   { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp RPAR>, <&kp GT>; mods = <(MOD_LSFT|MOD_RSFT)>; };
    };
    
    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &none &kp B &kp Y &kp O &kp U &mm_sqt_lpar    &mm_dqt_rpar   &kp D  &kp N &kp G &kp V &none
                &none &kp H &kp I &kp A &kp E &mm_com_sc      &mm_dot_co     &kp T  &kp R &kp S &kp C &none
                &none &kp K &kp P &kp J &kp W &kp MINUS       &mm_qmark_excl &kp M  &kp L &kp F &kp X &none
                      &lt FUN ESC &lt NUM SPACE &lt SYM TAB   &lt MOV RET &lt NAV BSPC &lt MED DEL
            >;
        };

        qwerty {
            display-name = "QWTY";
            bindings = <
                &none &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &none
                &none &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &none
                &none &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &none
                                &trans &trans &trans  &trans &trans &trans
            >;
        };

        function {
            display-name = "FUN";
            bindings = <
                &none &none    &none    &none     &none &none          &kp F12 &kp F7 &kp F8 &kp F9 &kp F12 &none
                &none &kp LGUI &kp LALT &kp LCTRL &kp LSHFT &kp LGUI   &kp F11 &kp F4 &kp F5 &kp F6 &kp F11 &none
                &none &none    &none    &none     &none &none          &kp F10 &kp F1 &kp F2 &kp F3 &kp F10 &none
                                                 &trans &trans &trans  &kp CAPS &caps_word &trans
            >;
        };

        number {
            display-name = "NUM";
            bindings = <
                &none &none    &none    &none     &none &none          &kp BSPC &mm_n7_fslh &mm_n8_star  &mm_n9_minus &kp BSPC &none
                &none &kp LGUI &kp LALT &kp LCTRL &kp LSHFT &kp LGUI   &kp TAB  &mm_n4_bslh &mm_n5_caret &mm_n6_plus  &kp TAB  &none
                &none &none    &none    &none     &none &none          &kp RET  &mm_n1_hash &mm_n2_dllr  &mm_n3_equal &kp RET  &none
                                                 &trans &trans &trans  &mm_com_sc &mm_n0_prcnt &mm_dot_co
            >;
        };

        symbol {
            display-name = "SYM";
            bindings = <
                &none &none    &none    &none     &none &none          &kp Q     &mm_sqt_grave &mm_dqt_at  &mm_amp_pipe         &kp Q     &none
                &none &kp LGUI &kp LALT &kp LCTRL &kp LSHFT &kp LGUI   &kp Z     &mm_lpar_lt   &mm_rpar_gt &mm_underscore_tilde &kp Z     &none
                &none &none    &none    &none     &none &none          &tog QWTY &kp LBKT      &kp LBKT    &mm_qmark_excl       &tog QWTY &none
                                                 &trans &trans &trans  &trans &trans &trans
            >;
        };

        movement {
            display-name = "MOV";
            bindings = <
                &none &mkp MB4 &kp LC(Z)      &mmv MOVE_UP   &kp LC(Y)       &mkp MB4   &none    &none     &none     &none    &none    &none
                &none &mo SCRL &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &mo SCRL   &kp LGUI &kp LSHFT &kp LCTRL &kp LALT &kp LGUI &none
                &none &mkp MB5 &kp LC(X)      &kp LC(C)      &kp LC(V)       &mkp MB5   &none    &none     &none     &none    &none    &none
                                                            &mkp MB3 &mkp MB1 &mkp MB2  &trans &trans &trans
            >;
        };

        scrolling {
            display-name = "SCRL";
            bindings = <
                &none &trans &trans         &msc MOVE_UP   &trans          &trans   &none    &none    &none     &none  &none       &none
                &none &trans &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_RIGHT &trans   &trans   &trans   &trans    &trans &trans      &none
                &none &trans &trans         &trans         &trans          &trans   &none    &none    &none     &none  &none       &none
                                                               &trans &trans &trans &trans &trans &trans
            >;
        };

        navigation {
            display-name = "NAV";
            bindings = <
                &none &kp PG_UP &kp LC(Z) &kp UP    &kp LC(Y) &kp PG_UP   &none    &none    &none    &none   &none   &none
                &none &kp PG_DN &kp LEFT  &kp DOWN  &kp RIGHT &kp PG_DN   &trans   &trans   &trans   &trans  &trans  &none
                &none &kp INS   &kp LC(X) &kp LC(C) &kp LC(V) &kp INS     &none    &none    &none    &none   &none   &none
                                               &kp HOME &kp BSPC &kp END  &trans &trans &trans
            >;
        };

        media {
            display-name = "MED";
            bindings = <
                &none &none        &none        &none        &none        &none           &none  &none  &none  &none  &none  &none
                &none &none        &none        &none        &none        &none           &trans &trans &trans &trans &trans &none
                &none &bt BT_SEL 4 &bt BT_SEL 3 &bt BT_SEL 2 &bt BT_SEL 1 &bt BT_SEL 4    &none  &none  &none  &none  &none  &none
                                                             &bt BT_SEL 0 &kp C_PP &trans &trans &trans &trans
            >;
        };

        mouse {
            display-name = "MOS";
            bindings = <
                &none &mkp MB4 &kp LC(Z) &kp LC(FSLH)  &kp LC(Y)  &mkp MB4   &none &none &none &none &none &none
                &none &kp LGUI &kp LALT  &kp LCTRL     &kp LSHFT  &kp LGUI   &none &none &none &none &none &none
                &none &mkp MB5 &kp LC(X) &kp LC(C)     &kp LC(V)  &mkp MB5   &none &none &none &none &none &none
                                                 &mkp MB3 &mkp MB1 &mkp MB2  &trans &trans &trans
            >;
        };
    };
};
